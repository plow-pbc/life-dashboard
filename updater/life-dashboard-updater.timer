[Unit]
Description=Run the Life Dashboard updater every 2 minutes

[Timer]
# OnActiveSec fires 1min after the timer is enabled -- bootstrap.sh enables it
# hours after boot, so OnBootSec alone had already elapsed and OnUnitActiveSec
# never arms until the service has run once: the timer sat "active (elapsed)"
# forever and bootstrap was never replaced by a real release.
OnActiveSec=1min
OnBootSec=1min
OnUnitActiveSec=2min
Persistent=true

[Install]
WantedBy=timers.target
