[Unit]
Description=Life Dashboard Viewer (calendar kiosk app + ICS proxy)

[Service]
Type=simple
WorkingDirectory=%h/services/life-dashboard-viewer
ExecStart=/usr/bin/node --env-file=%h/services/life-dashboard-viewer/.env %h/services/life-dashboard-viewer/server.js
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
