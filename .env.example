# Optional: full Google Calendar private ICS URL (treat as a secret). It feeds
# the wall's own calendar tile. Leave it blank when the calendar reaches the
# wall as agent-posted cards instead -- the tile renders empty and every
# other card is unaffected.
ICAL_URL=

# Optional. Max events to display (baked into the client at build time).
NEXT_N=12

# Optional. Page reload interval in ms (baked into the client at build time).
REFRESH_MS=300000

# Optional. Bearer that remote producers use to write: POST /api/message and
# the texted-photo CRUD (POST/DELETE /api/banners) — and that the deploy agent
# uses to read GET /api/version off-box. Setting it enables those
# APIs and binds the server on 0.0.0.0 (LAN-reachable); blank keeps the server
# loopback-only with muted message cards.
DASHBOARD_TOKEN=

# Optional. The Cook Tonight recipe strip: the recipe library JSON, WRITTEN BY
# the separate Paprika sync job (see SEED.md), never by this app. Cached photos
# are read from its sibling photos/ directory. Blank keeps /api/pinch/*
# unmounted and the strip off.
PINCH_DATA_FILE=
