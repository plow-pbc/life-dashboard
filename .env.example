# Optional ICS fallback. With no usable pushed feed, blank shows "Can't reach calendar".
ICAL_URL=

# Optional. Max events to display (baked into the client at build time).
NEXT_N=12

# Optional. Page reload interval in ms (baked into the client at build time).
REFRESH_MS=300000

# Optional (local mode). Bearer that remote producers use to write: POST
# /api/message, /api/calendar, and the texted-photo CRUD (POST/DELETE /api/banners) — and
# that the deploy agent uses to read GET /api/version off-box. Setting it
# enables those APIs and binds the server on 0.0.0.0 (LAN-reachable); blank
# keeps the server loopback-only with muted message cards.
# In remote mode (below) it holds the kiosk READ token instead.
DASHBOARD_TOKEN=

# Remote store mode — written by `bootstrap.sh --pair <code>`, never by hand.
# When KIOSK_REMOTE_URL is set the viewer polls its cards from the Plow kiosk
# store with DASHBOARD_TOKEN as the bearer (POST /api/message answers 405,
# the server stays loopback-only), and the updater reports each run to
# KIOSK_STATUS_URL. Blank = local mode, unchanged.
KIOSK_REMOTE_URL=
KIOSK_STATUS_URL=

# Optional. Weather tile location (US National Weather Service, no API key).
# Defaults to Mountain View if unset. The server resolves the NWS gridpoint from
# lat/lon, caches the result, and refreshes on an interval; the tile reads
# /api/weather. WEATHER_LOCATION is just the caption label.
WEATHER_LAT=37.386
WEATHER_LON=-122.083
WEATHER_LOCATION=Mountain View

# Optional. Followed teams for the Sports tile (ESPN public API, no API key), as
# a JSON array of { abbr, sport, league }. Blank/malformed → no teams, and the
# tile shows "No upcoming games". sport/league are ESPN path segments, e.g.
# football/nfl, basketball/nba, baseball/mlb, hockey/nhl, soccer/usa.1.
# SPORTS_TEAMS=[{"abbr":"SF","sport":"football","league":"nfl"},{"abbr":"GS","sport":"basketball","league":"nba"}]
SPORTS_TEAMS=

# Optional. The Cook Tonight recipe strip: the recipe library JSON, WRITTEN BY
# the separate Paprika sync job (see SEED.md), never by this app. Cached photos
# are read from its sibling photos/ directory. Blank keeps /api/pinch/*
# unmounted and the strip off.
PINCH_DATA_FILE=

# Optional. The Meals tab embeds the owner's Pinch recipe app in an iframe. Both
# of the next two are required for it to render (missing either → the tab shows a
# placeholder). Served at runtime via loopback-only GET /api/config, so a `.env`
# edit + viewer restart applies them with no client rebuild.
#
# PINCH_BACKEND_URL: the Pinch origin. Normalized to a bare https origin (no path/
# query) — it drives BOTH the iframe src and the CSP frame-src, so keep it clean.
PINCH_BACKEND_URL=
# PINCH_EMBED_TOKEN: the read-only Pinch embed token. The iframe carries it as
# `/embed?token=<token>` so Pinch renders the library instead of its login gate.
# Kept SEPARATE from PINCH_BACKEND_URL on purpose (that value is origin-only). The
# token is read-only and can ROTATE — paste the current value here and restart.
PINCH_EMBED_TOKEN=
